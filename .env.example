# Copy to .env and edit before running a real event.

# --- Database (Postgres) ---
# In docker-compose this points at the bundled `db` service. For local dev,
# point it at your own Postgres instance.
DATABASE_URL=postgres://ctf:ctf_db_password_change_me@localhost:5432/ctf

# --- Secrets ---
# Signs the session cookies. Use a long random string, e.g. openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Password for the organiser admin panel at /admin. CHANGE THIS.
ADMIN_PASSWORD=change-me-admin-password

# --- Optional default event identity (also editable live in the admin panel) ---
EVENT_NAME=Capture The Flag
EVENT_TAGLINE=Register a team, solve challenges, climb the board.
