{
  "name": "ctf-platform",
  "version": "2.0.0",
  "private": true,
  "description": "A reusable CTFd-style scoreboard and flag submission platform (Next.js + Postgres + Drizzle, TypeScript).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "drizzle-orm": "0.36.4",
    "pg": "8.13.1",
    "bcryptjs": "2.4.3"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/pg": "8.11.10",
    "@types/bcryptjs": "2.4.6",
    "drizzle-kit": "0.28.1",
    "tsx": "4.19.2"
  }
}
